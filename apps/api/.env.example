# Chaîne de connexion PostgreSQL de l'API Hono.
# Supabase : bouton « Connect » du projet > « Session pooler ».
# Copier ce fichier en .env (jamais commité) et remplacer les valeurs.
DATABASE_URL=postgresql://postgres.<ref-du-projet>:<mot-de-passe>@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require
