{
  "name": "pokemon-wishlist",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev -w @pokewishlist/web",
    "dev:api": "npm run dev -w @pokewishlist/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-locales.mjs",
    "test:scripts": "node --test scripts/check-locales.test.mjs scripts/smoke.test.mjs scripts/seo-html.test.mjs scripts/coverage-report.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "seo:html": "node scripts/seo-html.mjs",
    "coverage:report": "node scripts/coverage-report.mjs",
    "test:e2e": "npm run test:e2e -w @pokewishlist/web"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
